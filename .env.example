# PayGate402 — Environment Configuration Example (Arc Mainnet 5042)
# Copy this file to .env to configure local overrides (never commit secrets)

# Optional: Custom Arc Mainnet RPC endpoint (defaults to https://rpc.mainnet.arc.io)
# VITE_PUBLIC_ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io

# Optional: PayGate402 Gateway URL (defaults to http://localhost:4020 if omitted)
# VITE_GATEWAY_URL=http://localhost:4020
