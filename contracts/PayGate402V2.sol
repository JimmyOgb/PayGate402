pragma solidity ^0.8.20;

import "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import "@openzeppelin/contracts/utils/ReentrancyGuard.sol";

/**
 * @title PayGate402V2
 * @notice HTTP-402 Pay-Per-Call Protocol & AI Agent Gateway on Arc (Contract v2).
 *
 * Key Architectural Invariants:
 *  1. Pure Per-Call Micropayments: Removed perpetual `hasAccess` mapping and `verifyAccess()` view.
 *     Verification is per-call and single-use, validated off-chain by the PayGate gateway
 *     using the on-chain `AccessGranted(serviceId, caller, requestId, ...)` event combined with
 *     an EIP-712 signature from the paying caller.
 *  2. Contract-Wide Request ID Replay Protection: `usedRequestIds` is a single-level mapping
 *     `mapping(bytes32 => bool) public usedRequestIds`, enforcing strict single-use replay protection
 *     across all services and callers, matching the gateway SQLite PRIMARY KEY.
 *  3. Defense-in-Depth Reentrancy Protection: Combines strict Checks-Effects-Interactions (CEI)
 *     with OpenZeppelin's `ReentrancyGuard` (`nonReentrant` modifier) to protect against reentrancy
 *     from arbitrary tokens or future token proxy upgrade hooks.
 *  4. Event-Driven Access Proof: The canonical on-chain proof of payment is the `AccessGranted`
 *     receipt log, bound to the unique gateway-issued `requestId`.
 */
contract PayGate402V2 is ReentrancyGuard {
    IERC20 public immutable usdcToken;
    address public immutable protocolTreasury;
    uint256 public constant PROTOCOL_FEE_BPS = 500;
    uint256 public constant BPS_DENOMINATOR = 10000;
    uint256 public nextServiceId;

    struct Service {
        uint256 serviceId;
        address provider;
        string name;
        string endpointDescription;
        uint256 priceInUsdc;
        string gatedPayloadPreview;
        bool active;
        uint256 totalCalls;
        uint256 totalRevenue;
    }

    mapping(uint256 => Service) public services;
    // Request ID replay protection: strictly single-use across all services and callers
    mapping(bytes32 => bool) public usedRequestIds;

    event ServiceRegistered(
        uint256 indexed serviceId,
        address indexed provider,
        string name,
        uint256 priceInUsdc
    );

    event AccessGranted(
        uint256 indexed serviceId,
        address indexed caller,
        bytes32 indexed requestId,
        uint256 amountPaid,
        uint256 timestamp
    );

    event ServiceStatusUpdated(uint256 indexed serviceId, bool active);

    constructor(address _usdcToken, address _protocolTreasury) {
        require(_usdcToken != address(0), "Zero USDC address");
        require(_protocolTreasury != address(0), "Zero treasury address");
        usdcToken = IERC20(_usdcToken);
        protocolTreasury = _protocolTreasury;
    }

    /**
     * @notice Registers a new gated API service on the protocol.
     * @param name Human-readable service name (must not be empty)
     * @param endpointDescription Description of the service endpoint
     * @param priceInUsdc Price per call in USDC base units (6 decimals, min 20 base units)
     * @param gatedPayloadPreview Sample preview of the protected response
     */
    function registerService(
        string memory name,
        string memory endpointDescription,
        uint256 priceInUsdc,
        string memory gatedPayloadPreview
    ) external returns (uint256) {
        require(bytes(name).length > 0, "Empty service name");
        require(priceInUsdc >= 20, "Price too low for fee split (min 20 base units)");

        uint256 serviceId = nextServiceId;
        nextServiceId += 1;

        services[serviceId] = Service({
            serviceId: serviceId,
            provider: msg.sender,
            name: name,
            endpointDescription: endpointDescription,
            priceInUsdc: priceInUsdc,
            gatedPayloadPreview: gatedPayloadPreview,
            active: true,
            totalCalls: 0,
            totalRevenue: 0
        });

        emit ServiceRegistered(serviceId, msg.sender, name, priceInUsdc);
        return serviceId;
    }

    /**
     * @notice Pays USDC to unlock single-use access for a specific gateway challenge requestId.
     * @dev Follows strict Checks-Effects-Interactions (CEI) and uses nonReentrant modifier.
     *      Emits AccessGranted event which the gateway checks before serving the protected payload.
     * @param serviceId ID of the service being accessed
     * @param requestId Unique challenge requestId generated by the gateway (single-use globally)
     */
    function payForAccess(uint256 serviceId, bytes32 requestId) external nonReentrant {
        // 1. CHECKS
        require(serviceId < nextServiceId, "Service does not exist");

        Service storage service = services[serviceId];
        require(service.active, "Service inactive");
        require(requestId != bytes32(0), "Invalid requestId");
        require(!usedRequestIds[requestId], "Request already used");

        uint256 fee = (service.priceInUsdc * PROTOCOL_FEE_BPS) / BPS_DENOMINATOR;
        uint256 providerAmount = service.priceInUsdc - fee;

        // 2. EFFECTS (Updated BEFORE external calls)
        usedRequestIds[requestId] = true;
        service.totalCalls += 1;
        service.totalRevenue += service.priceInUsdc;

        // 3. INTERACTIONS (External token transfers)
        require(usdcToken.transferFrom(msg.sender, service.provider, providerAmount), "Provider transfer failed");
        require(usdcToken.transferFrom(msg.sender, protocolTreasury, fee), "Fee transfer failed");

        // 4. EVENT EMISSION
        emit AccessGranted(serviceId, msg.sender, requestId, service.priceInUsdc, block.timestamp);
    }

    /**
     * @notice Allows a service provider to activate or pause their registered service.
     * @param serviceId ID of the service to update
     * @param active True to activate, false to pause
     */
    function setServiceActive(uint256 serviceId, bool active) external {
        require(serviceId < nextServiceId, "Service does not exist");
        require(msg.sender == services[serviceId].provider, "Not service provider");

        services[serviceId].active = active;
        emit ServiceStatusUpdated(serviceId, active);
    }
}
